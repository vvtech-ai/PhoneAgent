# SDK credentials generated locally from explicitly authorized reference sources.
/ios/TrustedCallerSDK/Generated/
/android/app/src/debug/kotlin/com/vvtech/phone_agent/TrustedCallerLocalCredentials.kt*
/android/app/src/profile/kotlin/com/vvtech/phone_agent/TrustedCallerLocalCredentials.kt*
/android/app/src/release/kotlin/com/vvtech/phone_agent/TrustedCallerLocalCredentials.kt*
