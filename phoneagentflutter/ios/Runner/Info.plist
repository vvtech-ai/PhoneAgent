<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PhoneAgentInviteEnvironment</key><string>$(PHONEAGENT_IOS_ENV)</string>
    <key>NSUserActivityTypes</key>
    <array>
        <string>INSendMessageIntent</string>
    </array>
    <key>NSSupportsLiveActivities</key><true/>
    <key>FlutterDeepLinkingEnabled</key><false/>
    <key>NSPhotoLibraryAddUsageDescription</key><string>用于将您选择的邀请海报保存到相册。</string>
    <key>CFBundleURLTypes</key><array><dict>
        <key>CFBundleURLName</key><string>Invitation</string>
        <key>CFBundleURLSchemes</key><array><string>$(INVITE_URL_SCHEME)</string></array>
    </dict><dict>
        <key>CFBundleURLName</key><string>TrustedIdentity</string>
        <key>CFBundleURLSchemes</key><array><string>aiassistanttrustedcall</string></array>
    </dict></array>
	<key>NSCameraUsageDescription</key>
	<string>用于在您同意实名认证后进行本人跟读和活体采集。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于在您授权后进行语音对话、通话及实名认证跟读。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于在您授权后提供与当前位置相关的任务服务。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择对话中识别文字的图片及问题反馈截图。</string>
	<key>NSContactsUsageDescription</key>
	<string>用于展示本机联系人、选择拨号对象及按您的指令查找联系人。</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PHONEAGENT_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>phone_agent</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>TrustedCallerAPNSEnvironment</key>
	<string>$(TRUSTED_CALLER_APNS_ENVIRONMENT)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
