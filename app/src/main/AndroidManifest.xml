<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:name="com.vvtech.aiassistant.AIAssistantApplication"
        tools:replace="android:allowBackup,android:appComponentFactory,android:theme"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIAssistant">
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <activity
            android:name="com.vvtech.aiassistant.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.weway.chaken.incallsdk.MainActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.AgreementActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.NewSplashActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.SettingActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.AboutUsActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.SettingFinishActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.WebBrowserActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.SelectSimLoginActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.login.CountrySelectActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <activity
            android:name="com.weway.chaken.incallsdk.login.LoginActivity"
            android:theme="@style/Theme.ChakenIncall" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ota.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ota_file_paths" />
        </provider>
    </application>

</manifest>
